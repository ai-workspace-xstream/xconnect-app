# Xstream local environment template (no secrets)
# Copy to .env and fill with your local values.

# ===== Accounts / MCP =====
XSTREAM_ACCOUNTS_BASE_URL=https://accounts.example.com
XSTREAM_ACCOUNTS_USERNAME=your-account@example.com
XSTREAM_ACCOUNTS_PASSWORD=your-password
XSTREAM_MCP_DEBUG=false

# ===== Runtime (optional) =====
# macOS app bundle path used by runtime MCP launcher scripts.
XSTREAM_RUNTIME_APP_PATH=/Applications/xstream.app

# ===== OpenClaw local state (optional) =====
# Local bind mount path for GCS bucket openclawbot-data.
OPENCLAW_STATE_DIR=/data

# ===== Apple Signing & Network Extension (optional, build profile) =====
# Keep these aligned between Host App and Packet Tunnel Extension.
# - Same Apple Team ID
# - Same App Group ID
# - Correct provider bundle identifiers
XSTREAM_APPLE_TEAM_ID=YOUR_TEAM_ID
XSTREAM_APP_GROUP_ID=group.plus.svc.xconnect

# Host App bundle identifiers
XSTREAM_MACOS_BUNDLE_ID=plus.svc.xconnect
XSTREAM_IOS_BUNDLE_ID=plus.svc.xconnect

# Packet Tunnel provider bundle identifiers
XSTREAM_MACOS_PACKET_TUNNEL_BUNDLE_ID=plus.svc.xconnect.PacketTunnel
XSTREAM_IOS_PACKET_TUNNEL_BUNDLE_ID=plus.svc.xconnect.PacketTunnel

# Debug/variant example (optional)
# XSTREAM_IOS_DEBUG_BUNDLE_ID=plus.svc.xconnect.debug
# XSTREAM_IOS_DEBUG_PACKET_TUNNEL_BUNDLE_ID=plus.svc.xconnect.debug.PacketTunnel

# App Store Connect record for the iOS app (informational; the bundle ID performs the association).
# Apple ID: 6794950499
# SKU: svc_xconnect_app_v1
